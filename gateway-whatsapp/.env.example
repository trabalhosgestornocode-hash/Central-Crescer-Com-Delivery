# Gateway WhatsApp/Baileys — variáveis de ambiente.
# Nenhuma delas é uma credencial do Supabase/Postgres — de propósito
# (ver test/seguranca-sem-supabase.test.js).

# URL do backend Crescer (para as chamadas Gateway -> Backend). Nunca aponta
# para Supabase.
WHATSAPP_BACKEND_URL=https://crescercomdelivery.onrender.com

# Segredo HMAC — mínimo 32 caracteres. O processo RECUSA subir sem ele.
# Gere com: openssl rand -base64 48
WHATSAPP_GATEWAY_SECRET=

# Chave de cifra do auth state (AES-256-GCM) — 32 bytes em base64 ou hex.
# DIFERENTE do WHATSAPP_GATEWAY_SECRET (domínios de falha distintos — ver
# src/crypto.js). Nunca derive uma da outra.
# Gere com: openssl rand -base64 32
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Opcionais (têm default sensato em src/config.js)
# PORT=8080
# WHATSAPP_BACKEND_TIMEOUT_MS=15000
# WHATSAPP_MAX_BODY_BYTES=262144
# WHATSAPP_HEARTBEAT_MS=30000
# WHATSAPP_RECONNECT_BASE_MS=1000
# WHATSAPP_RECONNECT_TETO_MS=60000
# WHATSAPP_PROVIDER_INSTANCE_ID=default
# WHATSAPP_AUTH_METRICS_ENABLED=false
# Escopo de INBOUND: ALL_SUPPORTED (padrão, comportamento anterior) | DIRECT_ONLY (ignora grupos/status/broadcast/newsletter
# ANTES de decifrar; chat direto sempre passa). Ver docs/gateway-whatsapp-inbound-scope.md. Valor inválido cai no padrão.
# WHATSAPP_INBOUND_SCOPE=ALL_SUPPORTED
# Contadores SANITIZADOS por tipo de JID (evento inbound.contadores). Desligado por padrão.
# WHATSAPP_INBOUND_DIAG_ENABLED=false
# Reenvio sob RETRY RECEIPT ("Aguardando mensagem" no destinatário) — docs/whatsapp-retry-resend.md.
# Desligado por padrão: o socket nasce idêntico ao anterior e nada de conteúdo é gravado. Exige a migration 105 aplicada
# e o backend com as rotas /eventos/retry-cache. Ligar/desligar = env + restart (sem rollback de banco).
# Ligada, só são guardadas as mensagens que o BACKEND marcou com retryResend=true (allowlist por contato_id no backend:
# WHATSAPP_RETRY_RESEND_CONTATOS). Pedido sem a marca (ou com valor que não seja o booleano true) ⇒ enviado igual, NÃO guardado.
# WHATSAPP_RETRY_RESEND_ENABLED=false
# WHATSAPP_RETRY_CACHE_TTL_HORAS=168
# WHATSAPP_RETRY_MAX_REENVIOS=15
# Grupo interno da operação ("Crescer Com Delivery - Central") — ÚNICO grupo para o qual o Gateway envia (src/grupoInterno.js).
# Ausente ⇒ nenhum envio a grupo (a listagem GET /internal/whatsapp/grupos continua só leitura). Formato inválido ⇒ falha no boot.
# Precisa do MESMO valor em WHATSAPP_GRUPO_INTERNO_JID no backend. Descobrir o JID real pelo Painel (grupo-interno/grupos).
# WHATSAPP_GRUPO_INTERNO_JID=
