{
  "name": "subway-saci-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do sistema de gestão Subway Saci",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "dev:teste": "node --watch --env-file=.env.test-integracao src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules --env-file-if-exists=.env --test test/",
    "test:isolation": "node --env-file-if-exists=.env.test --test test/isolamento-tenant.test.js",
    "test:isolation:mb": "node --env-file-if-exists=.env.test --test test/isolamento-martinbrower.test.js",
    "test:isolation:all": "node --env-file-if-exists=.env.test --test test/isolamento-tenant.test.js test/isolamento-martinbrower.test.js",
    "test:estrutura": "node --env-file-if-exists=.env.test --test test/estrutura-organizacional.test.js",
    "test:exclusao-empresa": "node --env-file-if-exists=.env.test --test test/exclusao-empresa.test.js",
    "validate:technical-sheets": "node --env-file=.env scripts/auditar-fichas.mjs --strict",
    "audit:technical-sheets": "node --env-file=.env scripts/auditar-fichas.mjs",
    "diagnosticar:chaves": "node --env-file-if-exists=.env.test scripts/diagnosticar-chaves.js",
    "validar:fase-p0": "node --env-file-if-exists=.env scripts/validar-fase-p0.mjs",
    "test:integracao": "node --env-file=.env.test-integracao --test test/bonificacao-mensal-service.test.js test/bonificacao-mensal-rev-mensal.test.js test/bonificacao-mensal-fechamento-mensal.test.js test/bonificacao-mensal-metas-crud.test.js test/bonificacao-mensal-indicadores.test.js test/parser-food-delivery-paginacao.test.js test/agente-conversas-isolamento.test.js",
    "virada:superadmin": "node --env-file=.env scripts/virada-superadmin.js",
    "modelo:padrao": "node --env-file=.env scripts/criar-modelo-padrao.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "body-parser": "1.20.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
